# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=mooncraft_jewelry
DB_PORT=3306

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=http://localhost:4200

# Razorpay Configuration (get test keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_TAj9tyeLX1RLUC
RAZORPAY_KEY_SECRET=HDS0Kkx8Gkf5K8OkwKZyJPpy

# Public base URL this server is reachable at (used to build HTTPS image URLs
# for Meta's Graph API - must NOT be localhost in production)
PUBLIC_BASE_URL=http://localhost:5000

# Instagram Graph API (Admin > Share to Instagram feature)
# INSTAGRAM_USER_ID: the Instagram Business Account ID
# META_PAGE_ACCESS_TOKEN: long-lived System User Page Access Token
INSTAGRAM_USER_ID=
META_PAGE_ACCESS_TOKEN=
